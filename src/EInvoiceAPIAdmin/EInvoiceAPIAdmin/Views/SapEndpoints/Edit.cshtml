@model InvoiceWebApp.Models.SapEndpoint
@{
    ViewData["Title"] = $"SAP Endpoint: {Model.Name}";
    var passwordSaved = ViewBag.PasswordSaved == true;
}

<h3>SAP Endpoint: @Model.Name</h3>

<form asp-action="Edit" method="post" class="mt-3" autocomplete="off">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id" />
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="row g-3">
        <div class="col-12">
            <label class="form-label" for="url">SAP URL</label>
            <input class="form-control" id="url" name="url" value="@Model.Url" required />
        </div>
        <div class="col-12 col-md-6">
            <label class="form-label" for="username">Username (HTTP Basic)</label>
            <input class="form-control" id="username" name="username" value="@Model.Username" autocomplete="off" />
        </div>
        <div class="col-12 col-md-6">
            <label class="form-label" for="password">Password</label>
            <input class="form-control" id="password" name="password" type="password" autocomplete="new-password"
                   placeholder="@(passwordSaved ? "Saved: leave blank to keep" : "Not set")" />
            @if (passwordSaved)
            {
                <div class="form-check mt-1">
                    <input class="form-check-input" type="checkbox" id="clearPassword" name="clearPassword" value="true" />
                    <label class="form-check-label" for="clearPassword">Remove saved password</label>
                </div>
            }
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label" for="timeoutMs">Timeout (ms)</label>
            <input class="form-control" id="timeoutMs" name="timeoutMs" type="number" min="500" max="120000" value="@Model.TimeoutMs" />
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
        <a class="btn btn-secondary" asp-action="Index">Cancel</a>
    </div>
</form>
