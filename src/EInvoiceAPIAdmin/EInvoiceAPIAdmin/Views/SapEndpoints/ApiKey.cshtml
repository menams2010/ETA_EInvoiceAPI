@{
    ViewData["Title"] = "ETA Notifications API key";
    var keySet = ViewBag.KeySet == true;
    var suggested = (string)ViewBag.SuggestedKey;
}

<h3>ETA Notifications API key</h3>
<p class="text-muted">
    ETA sends this key with every notification (<code>Authorization: ApiKey &lt;key&gt;</code>).
    @if (keySet)
    {
        <strong>The current key stops working as soon as you save.</strong>
        <span>Update the key in the ETA portal at the same time, or notifications will be rejected.</span>
    }
</p>

<form asp-action="ApiKey" method="post" class="mt-3" autocomplete="off" style="max-width: 640px;">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-check">
        <input class="form-check-input" type="radio" name="mode" id="modeGenerate" value="generate" checked />
        <label class="form-check-label" for="modeGenerate">Use a new random key (recommended)</label>
    </div>
    <div class="ms-4 mb-3">
        <input class="form-control font-monospace" name="generatedKey" value="@suggested" readonly aria-label="Generated key" />
        <div class="form-text">Copy it into the ETA portal.</div>
    </div>

    <div class="form-check">
        <input class="form-check-input" type="radio" name="mode" id="modeCustom" value="custom" />
        <label class="form-check-label" for="modeCustom">Use this key (for example the key already set in the ETA portal):</label>
    </div>
    <div class="ms-4 row g-2">
        <div class="col-12">
            <input class="form-control font-monospace" name="apiKey" type="password" autocomplete="new-password"
                   placeholder="API key (@InvoiceWebApp.Models.NotificationSettings.MinApiKeyLength to @InvoiceWebApp.Models.NotificationSettings.MaxApiKeyLength characters, no spaces)" aria-label="API key" />
        </div>
        <div class="col-12">
            <input class="form-control font-monospace" name="confirmApiKey" type="password" autocomplete="new-password"
                   placeholder="Confirm the API key" aria-label="Confirm the API key" />
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save API key</button>
        <a class="btn btn-secondary" asp-action="Index">Cancel</a>
    </div>
</form>
