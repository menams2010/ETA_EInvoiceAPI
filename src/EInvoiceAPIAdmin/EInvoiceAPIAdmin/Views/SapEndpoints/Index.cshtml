@model List<InvoiceWebApp.Models.SapEndpoint>
@{
    ViewData["Title"] = "ETA Notifications";
    var notification = (InvoiceWebApp.Models.NotificationSettings)ViewBag.Notification;
    var keySet = !string.IsNullOrEmpty(notification.ApiKey);
}

<h3>ETA Notifications</h3>
<p class="text-muted">
    ETANotifications receives notifications from ETA and forwards each one to SAP.
    Changes on this page apply to the next request; no restart needed.
</p>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}
@if (ViewBag.Message != null)
{
    <div class="alert alert-success">@ViewBag.Message</div>
}

<h5 class="mt-4">API key</h5>
<p class="text-muted mb-2">
    ETA must send this key with every notification, as the header <code>Authorization: ApiKey &lt;key&gt;</code>.
    Requests without it get <code>401 "Bad API Key"</code>. Enter the same key in the ETA portal.
</p>
@if (keySet)
{
    <div class="input-group mb-1" style="max-width: 640px;">
        <input class="form-control font-monospace" id="notificationApiKey" type="password" value="@notification.ApiKey" readonly aria-label="API key" />
        <button class="btn btn-outline-secondary" type="button" id="toggleApiKey">Show</button>
        <button class="btn btn-outline-secondary" type="button" id="copyApiKey">Copy</button>
        <a class="btn btn-outline-primary" asp-action="ApiKey">Change</a>
    </div>
    <div class="form-text mb-3">
        @(notification.ApiKeyChangedUtc is { } changed ? $"Last changed {changed.ToLocalTime():yyyy-MM-dd HH:mm}." : "")
    </div>
}
else
{
    <div class="alert alert-warning d-flex align-items-center justify-content-between" style="max-width: 640px;">
        <span>No API key is set, so ETANotifications rejects every request.</span>
        <a class="btn btn-sm btn-primary" asp-action="ApiKey">Set API key</a>
    </div>
}

<h5 class="mt-4">SAP endpoints</h5>
<p class="text-muted mb-2">
    <strong>Prod</strong> is used by <code>.../ETANotifications/api/einvoice/...</code> and
    <strong>Dev</strong> by <code>.../ETANotifications/api/einvoice/dev/...</code>.
</p>

<div class="table-responsive">
    <table class="table table-striped table-sm align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>SAP endpoint URL</th>
                <th>Service user</th>
                <th>Password</th>
                <th>Timeout (ms)</th>
                <th style="width: 90px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td class="text-break">@item.Url</td>
                    <td>@(string.IsNullOrEmpty(item.Username) ? "—" : item.Username)</td>
                    <td>
                        @if (string.IsNullOrEmpty(item.Password))
                        {
                            <span class="badge bg-warning text-dark">Not set</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Saved</span>
                        }
                    </td>
                    <td>@item.TimeoutMs</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        (function () {
            var input = document.getElementById('notificationApiKey');
            if (!input) return;
            var toggle = document.getElementById('toggleApiKey');
            toggle.addEventListener('click', function () {
                var hidden = input.type === 'password';
                input.type = hidden ? 'text' : 'password';
                toggle.textContent = hidden ? 'Hide' : 'Show';
            });
            document.getElementById('copyApiKey').addEventListener('click', function () {
                var button = this;
                navigator.clipboard.writeText(input.value).then(function () {
                    button.textContent = 'Copied';
                    setTimeout(function () { button.textContent = 'Copy'; }, 1500);
                });
            });
        })();
    </script>
}
