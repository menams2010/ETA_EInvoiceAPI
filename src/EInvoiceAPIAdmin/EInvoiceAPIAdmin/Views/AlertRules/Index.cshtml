@model List<InvoiceWebApp.Models.AlertRule>
@using InvoiceWebApp.Models
@{
    ViewData["Title"] = "Alert Rules";
    AlertType? type = ViewBag.Type as AlertType?;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-0">Alert Rules</h3>
        <div class="text-muted">Configure alert levels, recipients, SMTP profile, and templates per rule.</div>
    </div>
    <a class="btn btn-primary" asp-action="Create" asp-route-type="@type">Create</a>
</div>

<div class="mb-3">
    <a class="btn btn-sm @(type is null ? "btn-primary" : "btn-outline-primary")" asp-action="Index">All</a>
    <a class="btn btn-sm @(type == AlertType.CertificateExpiration ? "btn-primary" : "btn-outline-primary")" asp-action="Index" asp-route-type="@AlertType.CertificateExpiration">Certificate</a>
    <a class="btn btn-sm @(type == AlertType.ClientSecretExpiration ? "btn-primary" : "btn-outline-primary")" asp-action="Index" asp-route-type="@AlertType.ClientSecretExpiration">Client/Secret</a>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}
@if (ViewBag.Message != null)
{
    <div class="alert alert-success">@ViewBag.Message</div>
}

<form asp-action="BatchEdit" method="post" id="batchEditForm" class="card card-body mb-3">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Type" value="@type" />
    <h5>Batch edit selected rules</h5>
    <p class="text-muted">Check only the fields to change. Applied To/CC values replace existing recipients; leave blank to clear. Other fields stay unchanged.</p>
    <div class="row g-3">
        <div class="col-md-6">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="ChangeTo" value="true" id="changeTo" />
                <label class="form-check-label" for="changeTo">Change To</label>
            </div>
            <input class="form-control" name="To" aria-label="New To recipients" placeholder="Comma or semicolon separated addresses" />
        </div>
        <div class="col-md-6">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="ChangeCc" value="true" id="changeCc" />
                <label class="form-check-label" for="changeCc">Change CC</label>
            </div>
            <input class="form-control" name="Cc" aria-label="New CC recipients" placeholder="Comma or semicolon separated addresses" />
        </div>
        <div class="col-md-6">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="ChangeEnabled" value="true" id="changeEnabled" />
                <label class="form-check-label" for="changeEnabled">Change enabled status</label>
            </div>
            <select class="form-select" name="Enabled" aria-label="New enabled status">
                <option value="true">Enabled</option>
                <option value="false">Disabled</option>
            </select>
        </div>
        <div class="col-md-6">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="ChangeSmtpProfile" value="true" id="changeSmtpProfile" />
                <label class="form-check-label" for="changeSmtpProfile">Change SMTP / Graph profile</label>
            </div>
            <select class="form-select" name="SmtpProfileId" asp-items="ViewBag.SmtpProfiles" aria-label="New mail profile">
                <option value="">Use default profile</option>
            </select>
        </div>
        <div class="col-12">
            <button class="btn btn-primary" type="submit">Apply to selected rules</button>
            <span class="ms-2" id="selectedRuleCount" aria-live="polite">0 selected</span>
        </div>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-sm align-middle">
        <thead>
            <tr>
                <th><input class="form-check-input" type="checkbox" id="selectAllRules" aria-label="Select all displayed rules" /></th>
                <th>Id</th>
                <th>Type</th>
                <th>Name</th>
                <th>Enabled</th>
                <th>Days</th>
                <th>To</th>
                <th>CC</th>
                <th>SMTP</th>
                <th>Template</th>
                <th style="width: 270px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><input class="form-check-input rule-selection" type="checkbox" name="SelectedIds" value="@item.Id" form="batchEditForm" aria-label="Select rule @item.Name (@item.Id)" /></td>
                    <td>@item.Id</td>
                    <td>@item.Type</td>
                    <td>@item.Name</td>
                    <td>@(item.Enabled ? "Yes" : "No")</td>
                    <td>@item.DaysBeforeExpiration</td>
                    <td class="text-truncate" style="max-width: 220px;">@item.To</td>
                    <td class="text-truncate" style="max-width: 220px;">@item.Cc</td>
                    <td>@(item.SmtpProfileId?.ToString() ?? "(default)")</td>
                    <td>@(item.EmailTemplateId?.ToString() ?? "")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                        <a class="btn btn-sm btn-outline-info" asp-action="Test" asp-route-id="@item.Id">Test alert</a>
                        <form class="d-inline" asp-action="Delete" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this rule?');">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<script>
    const ruleCheckboxes = Array.from(document.querySelectorAll('.rule-selection'));
    const selectAllRules = document.getElementById('selectAllRules');
    function updateRuleSelection() {
        const count = ruleCheckboxes.filter(x => x.checked).length;
        document.getElementById('selectedRuleCount').textContent = count + ' selected';
        selectAllRules.checked = count > 0 && count === ruleCheckboxes.length;
        selectAllRules.indeterminate = count > 0 && count < ruleCheckboxes.length;
    }
    selectAllRules.addEventListener('change', function () {
        ruleCheckboxes.forEach(x => x.checked = this.checked);
        updateRuleSelection();
    });
    ruleCheckboxes.forEach(x => x.addEventListener('change', updateRuleSelection));
    document.getElementById('batchEditForm').addEventListener('submit', function (event) {
        const count = ruleCheckboxes.filter(x => x.checked).length;
        if (!count) {
            event.preventDefault();
            alert('Select at least one alert rule.');
        } else if (!this.querySelector('input[name^="Change"]:checked')) {
            event.preventDefault();
            alert('Select at least one field to change.');
        } else if (!confirm('Apply the checked field changes to ' + count + ' selected rule(s)?')) {
            event.preventDefault();
        }
    });
    updateRuleSelection();
</script>
