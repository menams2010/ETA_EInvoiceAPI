@model List<InvoiceWebApp.Models.AlertRule>
@using InvoiceWebApp.Models
@{
    ViewData["Title"] = "Alert Rules";
    AlertType? type = ViewBag.Type as AlertType?;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-0">Alert Rules</h3>
        <div class="text-muted">Configure alert levels, recipients, SMTP profile, and templates per rule.</div>
    </div>
    <a class="btn btn-primary" asp-action="Create" asp-route-type="@type">Create</a>
</div>

<div class="mb-3">
    <a class="btn btn-sm @(type is null ? "btn-primary" : "btn-outline-primary")" asp-action="Index">All</a>
    <a class="btn btn-sm @(type == AlertType.CertificateExpiration ? "btn-primary" : "btn-outline-primary")" asp-action="Index" asp-route-type="@AlertType.CertificateExpiration">Certificate</a>
    <a class="btn btn-sm @(type == AlertType.ClientSecretExpiration ? "btn-primary" : "btn-outline-primary")" asp-action="Index" asp-route-type="@AlertType.ClientSecretExpiration">Client/Secret</a>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}
@if (ViewBag.Message != null)
{
    <div class="alert alert-success">@ViewBag.Message</div>
}

<div class="table-responsive">
    <table class="table table-striped table-sm align-middle">
        <thead>
            <tr>
                <th>Id</th>
                <th>Type</th>
                <th>Name</th>
                <th>Enabled</th>
                <th>Days</th>
                <th>To</th>
                <th>CC</th>
                <th>SMTP</th>
                <th>Template</th>
                <th style="width: 180px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Type</td>
                    <td>@item.Name</td>
                    <td>@(item.Enabled ? "Yes" : "No")</td>
                    <td>@item.DaysBeforeExpiration</td>
                    <td class="text-truncate" style="max-width: 220px;">@item.To</td>
                    <td class="text-truncate" style="max-width: 220px;">@item.Cc</td>
                    <td>@(item.SmtpProfileId?.ToString() ?? "(default)")</td>
                    <td>@(item.EmailTemplateId?.ToString() ?? "")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                        <form class="d-inline" asp-action="Delete" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this rule?');">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
