@model InvoiceWebApp.Models.AlertRule
@{
    ViewData["Title"] = "Edit Alert Rule";
}

<h3>Edit Alert Rule</h3>

<form asp-action="Edit" method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="row g-3">
        <div class="col-12 col-md-6">
            <label class="form-label" asp-for="Name"></label>
            <input class="form-control" asp-for="Name" />
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label">Type</label>
            <select class="form-select" asp-for="Type" asp-items="ViewBag.AlertTypes"></select>
        </div>
        <div class="col-12 col-md-3 d-flex align-items-end">
            <div class="form-check">
                <input class="form-check-input" asp-for="Enabled" />
                <label class="form-check-label" asp-for="Enabled"></label>
            </div>
        </div>

        <div class="col-12 col-md-3">
            <label class="form-label" asp-for="DaysBeforeExpiration"></label>
            <input class="form-control" asp-for="DaysBeforeExpiration" />
        </div>

        <div class="col-12 col-md-6">
            <label class="form-label" asp-for="To">To (comma separated)</label>
            <input class="form-control" asp-for="To" />
        </div>
        <div class="col-12 col-md-6">
            <label class="form-label" asp-for="Cc">CC (comma separated)</label>
            <input class="form-control" asp-for="Cc" />
        </div>

        <div class="col-12 col-md-6">
            <label class="form-label" asp-for="SmtpProfileId">SMTP Profile</label>
            <select class="form-select" asp-for="SmtpProfileId" asp-items="ViewBag.SmtpProfiles"></select>
        </div>
        <div class="col-12 col-md-6">
            <label class="form-label" asp-for="EmailTemplateId">Email Template</label>
            <select class="form-select" asp-for="EmailTemplateId" asp-items="ViewBag.EmailTemplates"></select>
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-primary">Save</button>
            <a class="btn btn-info" asp-action="Test" asp-route-id="@Model.Id">Test saved alert</a>
            <a class="btn btn-secondary" asp-action="Index">Cancel</a>
        </div>
    </div>
</form>
