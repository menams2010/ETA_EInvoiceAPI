@model List<InvoiceWebApp.Models.SmtpProfile>
@{
    ViewData["Title"] = "SMTP Profiles";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>SMTP Profiles</h3>
    <a class="btn btn-primary" asp-action="Create">Create</a>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}
@if (ViewBag.Message != null)
{
    <div class="alert alert-success">@ViewBag.Message</div>
}

<div class="table-responsive">
    <table class="table table-striped table-sm align-middle">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Provider</th>
                <th>Host</th>
                <th>Port</th>
                <th>Encryption Method</th>
                <th>SSL</th>
                <th>Default</th>
                <th style="width: 180px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var encryptionMethod = item.GetEffectiveEncryptionMethod();
                var encryptionError = item.GetEncryptionValidationError();
                var isGraph = item.DeliveryProvider == InvoiceWebApp.Models.SmtpProfile.ProviderGraph;
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@(isGraph ? "Microsoft Graph (OAuth2)" : item.DeliveryProvider)</td>
                    <td>@(isGraph ? "Microsoft Graph" : item.Host)</td>
                    <td>@(isGraph ? "—" : item.Port.ToString())</td>
                    <td>
                        @(isGraph ? "HTTPS" : encryptionMethod == InvoiceWebApp.Models.SmtpProfile.EncryptionStartTls ? "STARTTLS" : encryptionMethod)
                        @if (!isGraph && encryptionError is not null)
                        {
                            <span class="text-danger" title="@encryptionError">(unsupported)</span>
                        }
                    </td>
                    <td>@(isGraph ? "HTTPS" : encryptionError is not null ? "Unsupported" : encryptionMethod == InvoiceWebApp.Models.SmtpProfile.EncryptionStartTls ? "Yes" : "No")</td>
                    <td>@(item.IsDefault ? "Yes" : "No")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                        <form class="d-inline" asp-action="Delete" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this SMTP profile?');">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
