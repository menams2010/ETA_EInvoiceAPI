@model InvoiceWebApp.Models.EmailTemplate
@{
    ViewData["Title"] = "Edit Email Template";
}

<h3>Edit Email Template</h3>

<form asp-action="Edit" method="post" class="mt-3" id="templateForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="row g-3">
        <div class="col-12 col-md-6">
            <label class="form-label" asp-for="Name"></label>
            <input class="form-control" asp-for="Name" />
        </div>
        <div class="col-12 col-md-6 d-flex align-items-end">
            <div class="form-check">
                <input class="form-check-input" asp-for="IsHtml" id="isHtmlCheckbox" />
                <label class="form-check-label" asp-for="IsHtml"></label>
            </div>
        </div>

        <div class="col-12">
            <label class="form-label" asp-for="Subject"></label>
            <input class="form-control" asp-for="Subject" />
        </div>

        <div class="col-12">
            <label class="form-label" asp-for="Body"></label>
            <textarea class="form-control" asp-for="Body" rows="12" id="bodyTextarea"></textarea>
            <div class="form-text">Use placeholders like: {Type}, {Days}, {ExpirationDate}, {Entity}</div>
            <partial name="_PlaceholdersPalette" />
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-primary">Save</button>
            <button type="button" class="btn btn-info" id="previewBtn">
                <i class="bi bi-eye"></i> Preview
            </button>
            <a class="btn btn-secondary" asp-action="Index">Cancel</a>
        </div>
    </div>
</form>

<!-- Preview Modal -->
<div class="modal fade" id="previewModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Template Preview</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-bold">Subject:</label>
                    <div id="previewSubject" class="border rounded p-2 bg-light"></div>
                </div>
                <div>
                    <label class="form-label fw-bold">Body:</label>
                    <div id="previewBody" class="border rounded p-3 bg-light" style="min-height: 150px;"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- TinyMCE - Free Open Source (MIT License) -->
<script src="https://cdn.jsdelivr.net/npm/tinymce@7/tinymce.min.js"></script>

<script>
    (function() {
        const isHtmlCheckbox = document.getElementById('isHtmlCheckbox');
        const bodyTextarea = document.getElementById('bodyTextarea');
        let editorInitialized = false;

        // TinyMCE configuration - toolbar includes placeholders from the start
        const tinymceConfig = {
            selector: '#bodyTextarea',
            height: 400,
            menubar: true,
            plugins: [
                'anchor', 'autolink', 'charmap', 'codesample', 'emoticons',
                'link', 'lists', 'searchreplace', 'table', 'visualblocks',
                'wordcount', 'code', 'fullscreen', 'preview'
            ],
            toolbar: 'undo redo | blocks fontfamily fontsize | bold italic underline strikethrough | ' +
                     'link table | align lineheight | numlist bullist indent outdent | ' +
                     'emoticons charmap | removeformat | code fullscreen preview | placeholders',
            content_style: 'body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; font-size: 14px; }',
            branding: false,
            promotion: false,
            license_key: 'gpl',
            setup: function(editor) {
                // Custom button to insert placeholders
                editor.ui.registry.addMenuButton('placeholders', {
                    text: 'Placeholders',
                    fetch: function(callback) {
                        const items = [
                            { type: 'menuitem', text: '{Type}', onAction: () => editor.insertContent('{Type}') },
                            { type: 'menuitem', text: '{Days}', onAction: () => editor.insertContent('{Days}') },
                            { type: 'menuitem', text: '{ExpirationDate}', onAction: () => editor.insertContent('{ExpirationDate}') },
                            { type: 'menuitem', text: '{Entity}', onAction: () => editor.insertContent('{Entity}') },
                            { type: 'menuitem', text: '{CompanyName}', onAction: () => editor.insertContent('{CompanyName}') },
                            { type: 'menuitem', text: '{Environment}', onAction: () => editor.insertContent('{Environment}') },
                            { type: 'menuitem', text: '{RuleName}', onAction: () => editor.insertContent('{RuleName}') },
                            { type: 'menuitem', text: '{Severity}', onAction: () => editor.insertContent('{Severity}') }
                        ];
                        callback(items);
                    }
                });
                editor.on('init', function() {
                    editorInitialized = true;
                });
            }
        };

        // Get the placeholder palette card
        const placeholderPalette = document.getElementById('placeholderPaletteCard');

        // Initialize or destroy TinyMCE based on IsHtml checkbox
        function toggleEditor() {
            if (isHtmlCheckbox.checked) {
                // Hide placeholder palette when TinyMCE is active (has its own Placeholders menu)
                if (placeholderPalette) placeholderPalette.style.display = 'none';
                if (!editorInitialized) {
                    tinymce.init(tinymceConfig);
                }
            } else {
                // Show placeholder palette for plain text mode
                if (placeholderPalette) placeholderPalette.style.display = 'block';
                if (editorInitialized) {
                    // Save content before destroying
                    const editor = tinymce.get('bodyTextarea');
                    if (editor) {
                        bodyTextarea.value = editor.getContent();
                        editor.destroy();
                        editorInitialized = false;
                    }
                }
            }
        }

        // Sync TinyMCE content before form submit
        document.getElementById('templateForm').addEventListener('submit', function() {
            if (isHtmlCheckbox.checked && editorInitialized) {
                const editor = tinymce.get('bodyTextarea');
                if (editor) {
                    editor.save();
                }
            }
        });

        // Handle placeholder button clicks (palette) - insert into TinyMCE
        document.addEventListener('click', function(e) {
            const btn = e.target.closest('.placeholder-token');
            if (!btn) return;
            if (isHtmlCheckbox.checked && editorInitialized) {
                const editor = tinymce.get('bodyTextarea');
                if (editor) {
                    const token = btn.getAttribute('data-token');
                    editor.insertContent(token);
                    e.preventDefault();
                    e.stopPropagation();
                }
            }
        });

        isHtmlCheckbox.addEventListener('change', toggleEditor);

        // Initialize on page load
        toggleEditor();
    })();

    // Preview functionality
    document.getElementById('previewBtn').addEventListener('click', async function () {
        const form = document.getElementById('templateForm');
        const subject = form.querySelector('[name="Subject"]').value;
        const isHtml = document.getElementById('isHtmlCheckbox').checked;

        // Get body content
        let body;
        if (isHtml && tinymce.get('bodyTextarea')) {
            body = tinymce.get('bodyTextarea').getContent();
        } else {
            body = document.getElementById('bodyTextarea').value;
        }

        const token = form.querySelector('[name="__RequestVerificationToken"]').value;

        try {
            const response = await fetch('@Url.Action("Preview", "EmailTemplates")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ subject, body, isHtml })
            });

            if (response.ok) {
                const data = await response.json();
                document.getElementById('previewSubject').textContent = data.subject;
                if (data.isHtml) {
                    const preview = document.createElement('iframe');
                    preview.setAttribute('sandbox', '');
                    preview.title = 'Email preview';
                    preview.className = 'w-100 border-0';
                    preview.style.minHeight = '300px';
                    preview.srcdoc = '<meta http-equiv="Content-Security-Policy" content="default-src \'none\'; style-src \'unsafe-inline\'; img-src data:; form-action \'none\'">' + data.body;
                    document.getElementById('previewBody').replaceChildren(preview);
                } else {
                    document.getElementById('previewBody').textContent = data.body;
                }
                new bootstrap.Modal(document.getElementById('previewModal')).show();
            } else {
                alert('Failed to generate preview');
            }
        } catch (e) {
            alert('Error: ' + e.message);
        }
    });
</script>
