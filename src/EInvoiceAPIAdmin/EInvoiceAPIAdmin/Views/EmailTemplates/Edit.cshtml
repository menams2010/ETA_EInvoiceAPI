@model InvoiceWebApp.Models.EmailTemplate
@{
    ViewData["Title"] = "Edit Email Template";
}

<h3>Edit Email Template</h3>

<form asp-action="Edit" method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="row g-3">
        <div class="col-12 col-md-6">
            <label class="form-label" asp-for="Name"></label>
            <input class="form-control" asp-for="Name" />
        </div>
        <div class="col-12 col-md-6 d-flex align-items-end">
            <div class="form-check">
                <input class="form-check-input" asp-for="IsHtml" />
                <label class="form-check-label" asp-for="IsHtml"></label>
            </div>
        </div>

        <div class="col-12">
            <label class="form-label" asp-for="Subject"></label>
            <input class="form-control" asp-for="Subject" />
        </div>

        <div class="col-12">
            <label class="form-label" asp-for="Body"></label>
            <textarea class="form-control" asp-for="Body" rows="10"></textarea>
            <div class="form-text">Use placeholders like: {Type}, {Days}, {ExpirationDate}, {Entity}</div>
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-primary">Save</button>
            <a class="btn btn-secondary" asp-action="Index">Cancel</a>
        </div>
    </div>
</form>
