<?xml version="1.0" encoding="utf-8"?>
<!--
  Folder publish, x64 (win-x64). Default profile. A 64-bit process cannot load the 32-bit USB token driver (eps2003csp11.dll); use FolderProfile-x86 on servers that sign with the token.
  Output: <repo>\publish\x64\EInvoiceAPI\  (copy that folder to the IIS site).
  Command line: dotnet publish -c Release -p:PublishProfile=FolderProfile-x64
  Or use publish.ps1 at the repository root.
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <_TargetId>Folder</_TargetId>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <!-- Visual Studio uses PublishUrl; the dotnet publish command line uses PublishDir. Both point to <repo>/publish/x64/EInvoiceAPI/. -->
    <PublishUrl>$(MSBuildProjectDirectory)/../../../publish/x64/EInvoiceAPI/</PublishUrl>
    <PublishDir>$(MSBuildProjectDirectory)/../../../publish/x64/EInvoiceAPI/</PublishDir>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
    <!-- Target framework comes from Directory.Build.props (net10.0). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Framework-dependent: the server's ASP.NET Core 10 Hosting Bundle provides the runtime. -->
    <SelfContained>false</SelfContained>
  </PropertyGroup>
</Project>
