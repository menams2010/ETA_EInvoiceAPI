<?xml version="1.0" encoding="utf-8"?>
<!--
  Folder publish, x86 (win-x86). Use when signing with the 32-bit USB token driver (eps2003csp11.dll). IIS app pool: Enable 32-Bit Applications = True.
  Output: <repo>\publish\x86\EInvoiceAPI\  (copy that folder to the IIS site).
  Command line: dotnet publish -c Release -p:PublishProfile=FolderProfile-x86
  Or use publish.ps1 at the repository root.
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <_TargetId>Folder</_TargetId>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <!-- Visual Studio uses PublishUrl; the dotnet publish command line uses PublishDir. Both point to <repo>/publish/x86/EInvoiceAPI/. -->
    <PublishUrl>$(MSBuildProjectDirectory)/../../../publish/x86/EInvoiceAPI/</PublishUrl>
    <PublishDir>$(MSBuildProjectDirectory)/../../../publish/x86/EInvoiceAPI/</PublishDir>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
    <!-- Target framework comes from Directory.Build.props (net10.0). -->
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <!-- Framework-dependent: the server's ASP.NET Core 10 Hosting Bundle provides the runtime. -->
    <SelfContained>false</SelfContained>
  </PropertyGroup>
</Project>
