<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Target framework comes from Directory.Build.props at the repository root. -->
  <PropertyGroup>
    <RootNamespace>IncomeTaxWebAPI</RootNamespace>
    <AssemblyName>IncomeTaxWebAPI</AssemblyName>
    <!-- Ported from .NET Framework 4.5.2 without nullable annotations. -->
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Same RestSharp major version as before the port; 107+ changed the API these controllers use. -->
    <PackageReference Include="RestSharp" Version="106.15.0" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

</Project>
