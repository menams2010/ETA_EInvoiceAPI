<Project>
  <!--
    Shared settings for every SDK-style project in this repository.
    Change the target framework here to move the whole solution to a new .NET version.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      Web apps run out-of-process under IIS (dotnet/apphost process behind the ASP.NET Core Module) so that
      EInvoiceAPI, Admin and ETANotifications can share one app pool; in-process hosting allows only one app
      per pool (HTTP 500.35). Ignored by non-web projects.
    -->
    <AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>
  </PropertyGroup>
</Project>
